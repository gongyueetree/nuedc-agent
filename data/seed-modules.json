[
  {"id":"algo-pid-basic","name":"PID 控制器（位置式/增量式）","category":"other.algorithm","version":"1.0.0","description":"最基础的单闭环 PID，适用于温度、电压、速度、位置等绝大多数电赛控制对象。","principle":"u=Kp·e+Ki·∑e·T+Kd·(e−e_prev)/T；位置式直接算绝对输出，增量式算 Δu 累加，后者对积分饱和与执行器切换更友好。","main_chip":"MCU 软件实现（算法型条目）","interfaces":[{"interface_type":"ADC","description":"反馈量采集"},{"interface_type":"PWM","description":"控制量输出"}],"power":{"input_voltage_range":[0,0],"typical_current_ma":0},"usage_notes":["必须做积分限幅（抗饱和）与输出限幅，否则大扰动后会长时间过冲","采样周期要固定并远小于对象时间常数，用定时中断触发而不是主循环轮询"],"known_issues":["算法型条目，无对应实物模块；对纯滞后或强非线性对象整定困难"],"compatibility":["algo-pid-cascade","algo-pid-feedforward"],"competition_cases":[{"year":2021,"problem":"各类闭环控制题目（电源稳压、小车循迹、温控）","note":"最常用的基础控制律"}],"evidence_records":[{"param":"典型控制周期","value":"1~10","unit":"ms","evidence_level":"E0","conditions":"电机/电源类对象常用范围"}],"certification_status":"DRAFT","source_snapshot":{"source":"lab","captured_at":"2026-07-26"},"price":0,"tags":["PID","闭环控制","基础算法"]},
  {"id":"algo-pid-cascade","name":"串级 PID 控制","category":"other.algorithm","version":"1.0.0","description":"内外双环结构，外环控慢变量（位置/角度），内环控快变量（速度/电流），显著提升抗扰能力。","principle":"外环输出作为内环给定；内环带宽通常取外环的 5~10 倍，使内环在外环看来近似为理想的一阶环节。","main_chip":"MCU 软件实现（算法型条目）","interfaces":[{"interface_type":"ADC","description":"内外环反馈采集"},{"interface_type":"PWM","description":"最终执行量输出"}],"power":{"input_voltage_range":[0,0],"typical_current_ma":0},"usage_notes":["整定顺序必须先内环后外环，内环没调好时外环参数没有意义","内环执行频率应高于外环，常见内环 1kHz、外环 100Hz"],"known_issues":["算法型条目；两环带宽拉不开会互相耦合振荡"],"compatibility":["algo-pid-basic","actuator-bldc-drv8313"],"competition_cases":[{"year":2021,"problem":"H 题 自平衡/风力摆等强扰动控制题目","note":"角度外环 + 角速度内环"}],"evidence_records":[{"param":"内外环带宽比","value":"5~10","unit":"倍","evidence_level":"E0","conditions":"串级控制经典设计准则"}],"certification_status":"DRAFT","source_snapshot":{"source":"lab","captured_at":"2026-07-26"},"price":0,"tags":["串级PID","双闭环","抗扰"]},
  {"id":"algo-pid-feedforward","name":"前馈 + PID 复合控制","category":"other.algorithm","version":"1.0.0","description":"在反馈 PID 之外叠加基于模型的前馈量，大幅缩短响应时间并减小跟踪误差。","principle":"u=u_ff(r)+u_fb(e)；前馈项由被控对象逆模型或经验公式给出，反馈项只负责修正模型误差与扰动。","main_chip":"MCU 软件实现（算法型条目）","interfaces":[{"interface_type":"ADC","description":"反馈与扰动量采集"},{"interface_type":"PWM","description":"控制量输出"}],"power":{"input_voltage_range":[0,0],"typical_current_ma":0},"usage_notes":["前馈只能改善跟踪，不改变闭环稳定性，稳定性问题必须靠反馈解决","前馈曲线要在实际负载条件下标定，空载标定的曲线上负载后偏差很大"],"known_issues":["算法型条目；模型不准时前馈反而引入稳态偏差"],"compatibility":["algo-pid-basic"],"competition_cases":[{"year":2019,"problem":"电源变换与温控类题目","note":"负载突变时用负载电流做前馈"}],"evidence_records":[{"param":"典型超调改善","value":"显著","unit":"","evidence_level":"E0","conditions":"取决于前馈模型精度，需实测"}],"certification_status":"DRAFT","source_snapshot":{"source":"lab","captured_at":"2026-07-26"},"price":0,"tags":["前馈","复合控制","快速响应"]},
  {"id":"algo-lqr-statespace","name":"状态空间建模与 LQR 最优控制","category":"other.algorithm","version":"1.0.0","description":"对多状态耦合对象（倒立摆、自平衡车）建立状态方程，用 LQR 求全状态反馈增益。","principle":"x'=Ax+Bu，取代价函数 J=∫(xQx+uRu)dt，解 Riccati 方程得 K，u=-Kx；Q 惩罚状态偏差，R 惩罚控制能量。","main_chip":"MCU 软件实现（离线用 MATLAB/Python 求 K）","interfaces":[{"interface_type":"ADC","description":"状态量测量"},{"interface_type":"PWM","description":"控制量输出"}],"power":{"input_voltage_range":[0,0],"typical_current_ma":0},"usage_notes":["K 在上位机离线求解后以常数数组烧进 MCU，MCU 只做矩阵乘法，实时开销很小","不可测状态需要观测器或卡尔曼滤波估计，否则全状态反馈无法实现"],"known_issues":["算法型条目；对模型参数敏感，A/B 矩阵辨识不准时性能明显下降"],"compatibility":["algo-kalman-filter","sensor-imu-mpu6050"],"competition_cases":[{"year":2021,"problem":"自平衡/倒立摆类题目","note":"多状态耦合系统的最优反馈"}],"evidence_records":[{"param":"典型状态维数","value":"4","unit":"维","evidence_level":"E0","conditions":"一级倒立摆（位移、速度、角度、角速度）"}],"certification_status":"DRAFT","source_snapshot":{"source":"lab","captured_at":"2026-07-26"},"price":0,"tags":["LQR","状态空间","最优控制"]},
  {"id":"algo-kalman-filter","name":"卡尔曼滤波状态估计","category":"other.algorithm","version":"1.0.0","description":"融合含噪声的测量与过程模型，估计无法直接测量的状态，是 IMU 姿态与测距去噪的核心算法。","principle":"预测：x=Ax+Bu，P=APA+Q；更新：K=PH/(HPH+R)，x=x+K(z-Hx)；Q 大信模型，R 大信测量。","main_chip":"MCU 软件实现（算法型条目）","interfaces":[{"interface_type":"ADC","description":"传感器测量输入"},{"interface_type":"I2C","description":"数字传感器数据输入（如 IMU）"}],"power":{"input_voltage_range":[0,0],"typical_current_ma":0},"usage_notes":["Q/R 是唯一需要调的旋钮，先按传感器噪声方差给 R 的初值，再调 Q 折中响应与平滑","定点 MCU 上要注意协方差矩阵 P 的数值发散，可用一维简化卡尔曼或改用互补滤波"],"known_issues":["算法型条目；标准卡尔曼只适用于线性系统，非线性需 EKF/UKF，计算量成倍增加"],"compatibility":["algo-ahrs-attitude","algo-lqr-statespace"],"competition_cases":[{"year":2021,"problem":"自平衡车、四旋翼、测距类题目","note":"陀螺+加计融合、测距值去噪"}],"evidence_records":[{"param":"典型融合频率","value":"100~1000","unit":"Hz","evidence_level":"E0","conditions":"IMU 姿态融合常用范围"}],"certification_status":"DRAFT","source_snapshot":{"source":"lab","captured_at":"2026-07-26"},"price":0,"tags":["卡尔曼","状态估计","数据融合"]},
  {"id":"algo-ahrs-attitude","name":"AHRS 姿态解算（Mahony/Madgwick）","category":"other.algorithm","version":"1.0.0","description":"由陀螺、加速度计、磁力计数据解算出俯仰、横滚、航向，为飞行器与云台提供姿态反馈。","principle":"以陀螺积分为主得到高频姿态，用加速度计的重力方向修正俯仰/横滚漂移、用磁力计修正航向漂移；Mahony 用 PI 补偿器、Madgwick 用梯度下降，姿态以四元数表示避免万向节死锁。","main_chip":"MCU 软件 + MPU6050/ICM20948 等 IMU","interfaces":[{"interface_type":"I2C","description":"IMU 数据读取"},{"interface_type":"SPI","description":"高速 IMU 接口（可选）"}],"power":{"input_voltage_range":[0,0],"typical_current_ma":0},"usage_notes":["解算前必须做陀螺零偏标定与加计六面校准，磁力计要做椭球拟合硬磁/软磁补偿","解算周期要严格恒定，用定时中断驱动；周期抖动会直接表现为姿态抖动"],"known_issues":["算法型条目；载体线加速度大时加计修正失效，剧烈机动下俯仰横滚会短暂发散"],"compatibility":["sensor-imu-mpu6050","algo-kalman-filter"],"competition_cases":[{"year":2023,"problem":"四旋翼/云台稳定类题目","note":"姿态角反馈来源"}],"evidence_records":[{"param":"典型解算频率","value":"200~500","unit":"Hz","evidence_level":"E0","conditions":"飞控常用范围"}],"certification_status":"DRAFT","source_snapshot":{"source":"lab","captured_at":"2026-07-26"},"price":0,"tags":["AHRS","四元数","姿态解算","IMU"]},
  {"id":"algo-fuzzy-control","name":"模糊控制器","category":"other.algorithm","version":"1.0.0","description":"用语言规则代替精确模型的控制方法，适合难以建模或强非线性的对象。","principle":"把误差 e 与误差变化率 ec 模糊化为 NB/NM/NS/ZO/PS/PM/PB 等语言变量，按规则表推理得到模糊输出，再用重心法去模糊化为实际控制量；常与 PID 结合做模糊自整定 PID。","main_chip":"MCU 软件实现（算法型条目）","interfaces":[{"interface_type":"ADC","description":"误差量采集"},{"interface_type":"PWM","description":"控制量输出"}],"power":{"input_voltage_range":[0,0],"typical_current_ma":0},"usage_notes":["规则表可离线算好存成二维数组，MCU 只做查表+插值，实时性完全够用","量化因子和比例因子的选取比规则表本身更影响性能，需实验标定"],"known_issues":["算法型条目；缺乏严格的稳定性证明，参赛答辩时需要用实验数据说明"],"compatibility":["algo-pid-basic"],"competition_cases":[{"year":2019,"problem":"温控、非线性对象控制类题目","note":"大惯性纯滞后对象的整定替代方案"}],"evidence_records":[{"param":"典型规则数","value":"49","unit":"条","evidence_level":"E0","conditions":"7x7 语言变量规则表"}],"certification_status":"DRAFT","source_snapshot":{"source":"lab","captured_at":"2026-07-26"},"price":0,"tags":["模糊控制","规则表","非线性"]},
  {"id":"algo-adaptive-control","name":"自适应控制（参数在线辨识）","category":"other.algorithm","version":"1.0.0","description":"在线辨识对象参数并实时调整控制器增益，应对负载或工况大范围变化。","principle":"用递推最小二乘（RLS）或梯度法在线估计对象参数，再按极点配置或模型参考自适应（MRAC）实时更新控制器参数，使闭环跟踪参考模型。","main_chip":"MCU 软件实现（算法型条目）","interfaces":[{"interface_type":"ADC","description":"输入输出数据采集用于辨识"},{"interface_type":"PWM","description":"控制量输出"}],"power":{"input_voltage_range":[0,0],"typical_current_ma":0},"usage_notes":["辨识需要激励充分，稳态时数据无信息量，应加入小幅激励信号或设置参数冻结逻辑","必须对估计参数设上下限并加遗忘因子，防止数据漂移导致增益爆掉"],"known_issues":["算法型条目；实现复杂度与调试成本高，比赛时间紧张时收益不一定大于串级 PID"],"compatibility":["algo-pid-basic","algo-lqr-statespace"],"competition_cases":[{"year":2021,"problem":"负载大范围变化的电源/电机题目","note":"变负载下保持一致的动态性能"}],"evidence_records":[{"param":"典型辨识方法","value":"RLS","unit":"","evidence_level":"E0","conditions":"递推最小二乘，适合 MCU 实时实现"}],"certification_status":"DRAFT","source_snapshot":{"source":"lab","captured_at":"2026-07-26"},"price":0,"tags":["自适应","在线辨识","MRAC"]},
  {"id":"algo-mpc-predictive","name":"模型预测控制（MPC）","category":"other.algorithm","version":"1.0.0","description":"基于模型滚动预测未来输出并在约束下优化控制序列，天然处理输入输出限幅。","principle":"每个周期用模型预测未来 N 步输出，最小化跟踪误差与控制增量的加权代价，在幅值/速率约束下求解二次规划，只执行第一步控制量，下周期重复（滚动优化）。","main_chip":"MCU/DSP 软件实现（算法型条目）","interfaces":[{"interface_type":"ADC","description":"状态与输出反馈"},{"interface_type":"PWM","description":"控制量输出"}],"power":{"input_voltage_range":[0,0],"typical_current_ma":0},"usage_notes":["预测时域与控制时域取太长会让求解量爆炸，MCU 上通常取 N=5~20 并用显式 MPC 查表","电力电子中常用有限控制集 MPC（FCS-MPC），穷举有限开关状态即可，无需解 QP"],"known_issues":["算法型条目；计算量远大于 PID，低端 MCU 需降频运行或改用显式解"],"compatibility":["algo-lqr-statespace"],"competition_cases":[{"year":2023,"problem":"逆变器/变换器控制类题目","note":"有限控制集 MPC 直接选开关状态"}],"evidence_records":[{"param":"典型预测时域","value":"5~20","unit":"步","evidence_level":"E0","conditions":"嵌入式实现常用范围"}],"certification_status":"DRAFT","source_snapshot":{"source":"lab","captured_at":"2026-07-26"},"price":0,"tags":["MPC","滚动优化","约束控制"]},
  {"id":"algo-sliding-mode","name":"滑模变结构控制","category":"other.algorithm","version":"1.0.0","description":"通过切换控制律把系统状态强制约束在滑模面上，对参数摄动和外扰具有强鲁棒性。","principle":"设计滑模面 s=ce+de，控制律 u=u_eq+K*sign(s)，使 s*ds<0 保证有限时间到达；到达后系统动态只由滑模面决定，与对象参数无关。","main_chip":"MCU 软件实现（算法型条目）","interfaces":[{"interface_type":"ADC","description":"状态反馈采集"},{"interface_type":"PWM","description":"控制量输出"}],"power":{"input_voltage_range":[0,0],"typical_current_ma":0},"usage_notes":["sign 函数会引起高频抖振，实用中要用饱和函数 sat(s/φ) 或超螺旋算法削弱","切换增益 K 要大于扰动上界才能保证鲁棒性，但过大直接放大抖振，需要折中"],"known_issues":["算法型条目；抖振会激励机械谐振并增加执行器损耗"],"compatibility":["algo-lqr-statespace","algo-pid-basic"],"competition_cases":[{"year":2023,"problem":"强扰动/参数不确定的控制题目","note":"负载突变下的鲁棒跟踪"}],"evidence_records":[{"param":"抖振抑制常用方法","value":"边界层 sat 函数","unit":"","evidence_level":"E0","conditions":"经典滑模改进手段"}],"certification_status":"DRAFT","source_snapshot":{"source":"lab","captured_at":"2026-07-26"},"price":0,"tags":["滑模","鲁棒控制","变结构"]},
